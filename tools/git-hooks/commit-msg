#!/usr/bin/env bash
set -euo pipefail
message_path="$1"
if [[ "$message_path" != /* ]]; then
    message_path="$PWD/$message_path"
fi
cd -- "$(git rev-parse --show-toplevel)"
.toolchains/python/bin/python3 -B tools/privacy/check_public_tree.py --message "$message_path"
exec .toolchains/gitleaks/gitleaks stdin --redact=100 --no-banner --no-color < "$message_path"
