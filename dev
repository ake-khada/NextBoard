#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
if [[ ! -x .toolchains/python/bin/python3 ]]; then
    echo 'Install an independent Python into .toolchains/python before using this launcher.' >&2
    exit 1
fi
case "$(readlink -f .toolchains/python/bin/python3)" in
    "$PWD"/.toolchains/*) ;;
    *) echo 'Refusing an interpreter outside this checkout.' >&2; exit 1 ;;
esac
exec .toolchains/python/bin/python3 -I tools/dev/runner.py "$@"
